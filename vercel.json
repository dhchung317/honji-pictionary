{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cleanup-blobs",
      "schedule": "0 5 * * *"
    }
  ],
  "functions": {
    "api/cleanup-blobs.ts": {
      "maxDuration": 120
    }
  }
}
